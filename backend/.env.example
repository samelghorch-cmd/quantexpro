# Configuration backend QuantEXPro — copier en `.env` (jamais committer `.env`).
QX_ENV=development

# TimescaleDB (driver async asyncpg).
QX_DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:5432/quantexpro

# Bus ZDL (Redis Streams) — app.bus (P0-C). Opt-in : laisser false sans Redis.
QX_REDIS_URL=redis://localhost:6379/0
QX_BUS_ENABLED=false
QX_BUS_CONSUMER_GROUP=quant-engines
QX_BUS_MAX_RETRIES=3

# Clés d'API acceptées (CSV). Vide = accès refusé en production.
QX_API_KEYS=

# LLM local Qwen2.5-Coder-7B (Prompt Mode, zero-token) — opt-in, endpoint OpenAI-compatible.
QX_LLM_ENABLED=false
QX_LLM_BASE_URL=http://localhost:11434/v1
QX_LLM_MODEL=qwen2.5-coder:7b
QX_LLM_API_KEY=not-needed

# Réglages optionnels.
QX_LOG_LEVEL=INFO
QX_DEFAULT_PAGE_LIMIT=1000
QX_MAX_PAGE_LIMIT=10000
QX_MAX_INGEST_BATCH=10000
